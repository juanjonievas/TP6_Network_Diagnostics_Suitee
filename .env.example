# Network Diagnostics Suite - Variables de Entorno de Ejemplo
# NO colocar credenciales reales ni IPs fijas de producción aquí.

# Dirección base del Backend de Sincronización
# Para pruebas locales en la misma red Wi-Fi: http://<IP_LOCAL_DE_TU_PC>:3000
# Para emulador Android (si aplica): http://10.0.2.2:3000
BACKEND_SYNC_URL=http://192.168.1.100:3000

# Parámetros por defecto para SNMP
DEFAULT_SNMP_COMMUNITY=public
DEFAULT_SNMP_PORT=161
DEFAULT_SNMP_TIMEOUT_MS=2500

# Parámetros por defecto para SSH
DEFAULT_SSH_PORT=22
DEFAULT_SSH_TIMEOUT_MS=8000
